# Copy this file to .env and fill in your values.

PORT=3000
NODE_ENV=development
# Number of proxies in front of the app. 0 locally; 1 on Render or Railway.
TRUST_PROXY=0
# Where the React app runs (used for CORS). Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chatgpt_clone

# Cloud databases (Aiven, etc.) need an encrypted connection.
# Set DB_SSL=true and give the CA certificate from your database provider, either:
#   - as a file (easiest): download it into the backEnd folder and set DB_SSL_CA_FILE=./ca.pem
#   - or as text: paste it into DB_SSL_CA (inside double quotes, or with \n for line breaks)
# Check the connection with: npm run db:check
DB_SSL=false
DB_SSL_CA_FILE=
DB_SSL_CA=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional request limits per visitor (defaults shown)
RATE_LIMIT_AUTH_PER_15_MIN=20
RATE_LIMIT_MESSAGES_PER_MIN=15
